# Vercel Environment Variables
# ეს ფაილი მხოლოდ მაგალითია; რეალური მნიშვნელობები Vercel-ში დაამატე.
# NEVER commit .env to git!

# Supabase (Project Settings → API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...   # service_role key!

# JWT signing secret — ნებისმიერი გრძელი random string
# გენერაცია: openssl rand -hex 32
ADMIN_SECRET=change_me_to_a_long_random_string

# Initial admin password (fallback თუ Supabase-ში password არ არის შენახული)
ADMIN_PASSWORD=admin123

